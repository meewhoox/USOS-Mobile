{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "USOS Mobile",
  "description": "__MSG_extDescription__",
  "version": "0.1.0",
  "default_locale": "pl",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "usos-mobile-polsl@extension",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "128.0"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://usosweb.polsl.pl/*"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "__MSG_extName__",
    "default_icon": "icons/icon.svg"
  },
  "content_scripts": [
    {
      "matches": ["https://usosweb.polsl.pl/*"],
      "js": ["early.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://usosweb.polsl.pl/*"],
      "js": [
        "content/core.js",
        "content/features/topbar.js",
        "content/features/drawer.js",
        "content/features/account.js",
        "content/features/tabs.js",
        "content/features/content.js",
        "content/pages/home.js",
        "content/main.js"
      ],
      "run_at": "document_start"
    }
  ]
}
